
                server {
        listen 80;
        server_name 16hn.ddns.net;

        # Redirect HTTP to HTTPS
        location / {
        return 301 https://$host$request_uri;
                }
        }

              server {
        listen 443 ssl;
        server_name 16hn.ddns.net;

        ssl_certificate /etc/letsencrypt/live/16hn.ddns.net/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/16hn.ddns.net/privkey.pem;

        # Enable SSL protocols and ciphers
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers 'EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH';


#Certificate is saved at: /etc/letsencrypt/live/16hn.ddns.net/fullchain.pem
#Key is saved at:         /etc/letsencrypt/live/16hn.ddns.net/privkey.pem


        root /var/www/html;
        index index.nginx-debian.html;

        location  ~* \.jpg$   {

                image_filter rotate 180;
                root /var/www/html;
                }


#       location / {
                #root var/www/html/;

                #proxy_pass http://127.0.0.1:8080/;
                #}
        }

