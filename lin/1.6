    Сделать регулярное выражение для отображения картинок(png, jpg). Если формат jpg, то перевернуть картинку с помощью nginx. 
*\.png *\.jpg
sudo apt install libnginx-mod-http-image-filter    


location /путь_к_изображениям {
    if ($request_filename ~* ^.*\.jpg$) {
        image_filter rotate 180;
    }

    if ($rotate_image = "1") {
        proxy_pass http://localhost:8080;  # Поменяйте это на вашу конфигурацию прокси
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Добавьте здесь необходимую конфигурацию для переворота изображения
        # Например, используйте модуль ngx_http_image_filter_module:
        # image_filter rotate 180;
    }

    # Добавьте здесь остальную конфигурацию для обработки изображений
}

image_filter rotate 180
    rotates images counter-clockwise by the specified number of degrees. Parameter value can contain variables.
