    Добавь в /home/user/gocalc/Dockerfile директиву ARG с секретом в первый образ и запиши его значение в файл в конечном образе. Собери образ.

FROM golang:1.19.1-alpine
ENV GO111MODULE=auto
ARG SECRET=secret
RUN apk add git
#RUN echo $GOPATH  =/go 
WORKDIR /go/src/app
COPY . .
RUN echo "$SECRET" > secret.txt
RUN go get -d -v
RUN go build -o app
FROM alpine:3.10.3
COPY --from=0 /go/src/app/app /usr/local/bin
COPY --from=0 /go/src/app/secret.txt /usr/local/bin/
CMD ["/go/src/app/app"]




