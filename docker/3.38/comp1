version: '3'
services:
  mysql:
    image: mysql:5.6
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: 'password'
      MYSQL_USER: 'voting'
      MYSQL_PASSWORD: 'voting'
      MYSQL_DATABASE: 'voting'
    depends_on:
      - nginx
    volumes:
      - my-db:/var/lib/mysql

  voting:
    image: voting:latest
    ports:
      - "9000:9000"
    build: .
    environment: 
        DB_HOST: "mysql"
        DB_PORT: "3306"
        DB_DATABASE: "voting"
        DB_USERNAME: "voting"
        DB_PASSWORD: "voting"

 
  redis:
    image: redis:latest
    environment:
        REDIS_HOST: "redis"
        REDIS_PASSWORD: ""
        SESSION_DRIVER: "redis"
        SESSION_CONNECTION: "session"
        CACHE_DRIVER: "redis"

  nginx:
    image: nginx:stable-alpine 
    ports:
      - "20000:80"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - ./public:/var/www/html/public
    restart: unless-stopped

volumes:
  my-db:











































