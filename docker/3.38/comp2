services:
  nginx:
    image: nginx:stable-alpine
    ports:
      - "20000:80"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf
      - ./public:/var/www/html/public
    restart: unless-stopped


  voting:
    image: voting
    build: .
    ports:
      - '7070:7070'
    environment:
      DB_HOST: 'mysql'
      DB_PORT: '3306'
      DB_USERNAME: 'voting'
      DB_PASSWORD: 'voting'
      DB_DATABASE: 'voting'
    depends_on:
      - mysql
    restart: unless-stopped


  mysql:
    image: mysql:latest
    ports:
      - '3306:3306'
    expose:
      - '3306'
    environment:
      MYSQL_DATABASE: 'voting'
      MYSQL_PORT: '3306'
      MYSQL_USER: 'voting'
      MYSQL_PASSWORD: 'voting'
      MYSQL_ROOT_PASSWORD: 'password'
    volumes:
      - db:/var/lib/mysql
    depends_on:
      - nginx
    restart: unless-stopped


  redis:
    image: redis
    ports:
      - "6379:6379"
    environment:
      REDIS_HOST: "redis"
      REDIS_PASSWORD: ""
      SESSION_DRIVER: "redis"
      SESSION_CONNECTION: "session"
      CACHE_DRIVER: "redis"
    restart: unless-stopped


volumes:
  db:
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
