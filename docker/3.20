    Запусти контейнер из этого образа с именем inno-dkr-10 в фоновом режиме и с передачей переменной окружения INNO=DKR10.
root@Vostro-3580:/home/sokol/3-20# docker run -d --name inno-dkr-10 -e INNO=DKR10 nginx:inno-dkr-10
4dbb096735f078842e0038111382a804b60dea62bc4239b63ae35d621190237d



