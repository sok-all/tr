    Опционально: Объедини команду скачки/распаковки mvn, команду сборки приложения и команду удаления mvn (после сборки приложения менеджер пакетов не нужен в образе) в одну директиву RUN. Собери образ заново и оцени новые размеры образов и слоёв
    
FROM openjdk:8-jdk-buster
COPY . .
RUN apt-get update && apt-get install -y curl \
 && curl -O -k  https://mirrors.estointernet.in/apache/maven/maven-3/3.6.3/binaries/apache-maven-3.6.3-bin.tar.gz\
 && tar -xvzf apache-maven-3.6.3-bin.tar.gz \
 && export PATH=/apache-maven-3.6.3/bin:$PATH \
 && mvn clean install -DskipTests

docker build . -f Dockerfile.buster -t zookeeper-buster:t   
[+] Building 273.1s (8/8) FINISHED                                                        docker:default 



FROM openjdk:8-jdk-alpine
COPY . .
RUN apk update && apk add curl \
&&  curl -O -k  https://mirrors.estointernet.in/apache/maven/maven-3/3.6.3/binaries/apache-maven-3.6.3-bin.tar.gz\
&& tar -xvzf apache-maven-3.6.3-bin.tar.gz \
&& export PATH=/apache-maven-3.6.3/bin:$PATH \
&& mvn clean install -DskipTests \
&& rm -rf apache-maven-3.6.3
  
docker build . -f Dockerfile.alpine -t zookeeper-alpine:t
