

    Запусти Docker в Docker, используя первый метод (dind).
docker run --privileged -d docker:dind


    Подключись к контейнеру c Docker и выполни внутри него следующие действия:

        Получи список текущих образов и всех контейнеров;

        Скачай образ redis:5;

        Создай из загруженного образа контейнер с именем inno-dkr-26, работающий в фоне;

        Еще раз выведи список всех контейнеров;

        Удали контейнер;

        Еще раз выведи список всех контейнеров.




root@Vostro-3580:/home/sokol# docker run -d --privileged --name dind docker:dind
3a19dd4eb43f0a7484cdabba162f2f800948c6b058c0c01f76c604526c8642d4
root@Vostro-3580:/home/sokol# docker pps
docker: 'pps' is not a docker command.
See 'docker --help'
root@Vostro-3580:/home/sokol# docker ps
CONTAINER ID   IMAGE         COMMAND                  CREATED         STATUS         PORTS           NAMES
3a19dd4eb43f   docker:dind   "dockerd-entrypoint.…"   6 seconds ago   Up 5 seconds   2375-2376/tcp   dind
root@Vostro-3580:/home/sokol# docker ps
root@Vostro-3580:/home/sokol# docker exec -it dind sh
/ # docker ps -a
CONTAINER ID   IMAGE     COMMAND   CREATED   STATUS    PORTS     NAMES
