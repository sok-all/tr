<source>   @type forward   port 24224   bind 0.0.0.0 </source> <match *.**>   @type copy   <store>     @type elasticsearch     host elasticsearch     port 9200     logstash_format true     logstash_prefix fluentd     logstash_dateformat %Y%m%d     include_tag_key true     type_name access_log     tag_key @log_name     flush_interval 1s   </store>   <store>     @type stdout   </store> </match>

  
  
  
  
  
  
  
  
  
  
  
  
  
 version: '3.8'

services:

  mysql:

    image: mysql:5.6

    ports:

      - "3306:3306"

    environment:

      MYSQL_ROOT_PASSWORD: 'password'

      MYSQL_USER: 'voting'

      MYSQL_PASSWORD: 'voting'

      MYSQL_DATABASE: 'voting'

    volumes:

      - my-db:/var/lib/mysql

    logging:

      driver: fluentd

      options:

        fluentd-address: "localhost:24224"

        tag: my-mysql-service

  voting:

    image: voting:latest

    ports:

      - "9000:9000"

    build: .

    environment: 

        DB_HOST: "mysql"

        DB_PORT: "3306"

        DB_DATABASE: "voting"

        DB_USERNAME: "voting"

        DB_PASSWORD: "voting"

    logging:

      driver: "fluentd"

      options:

        fluentd-address: "localhost:24224"

  redis:

    image: redis:latest

    environment:

        REDIS_HOST: "redis"

        REDIS_PASSWORD: ""

        SESSION_DRIVER: "redis"

        SESSION_CONNECTION: "session"

        CACHE_DRIVER: "redis"

    logging:

      driver: fluentd

      options:

        fluentd-address: "localhost:24224"

        tag: my-redis-service

  nginx:

    image: nginx:stable-alpine 

    ports:

      - "20000:80"i

    volumes:

      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro

      - ./public:/var/www/html/public

    restart: unless-stopped

    logging:

      driver: fluentd

      options:

        fluentd-address: "localhost:24224"

        tag: my-nginx-service

  elasticsearch:

    image: elasticsearch:8.12.0

    expose: # Exposes the default port 9200

      - "9200:9200"

    environment:

      - discovery.type=single-node

      - cluster.routing.allocation.disk.threshold_enabled=true

      - cluster.routing.allocation.disk.watermark.low=65%

      - cluster.routing.allocation.disk.watermark.high=70%

      - xpack.security.enabled=false

      - xpack.security.audit.enabled=false

      - ELASTIC_PASSWORD=hUEEiktfqz80TGhJi_Dl

  fluentd: 

    build: ./fluentd

    volumes:

      - ./fluentd/conf:/fluentd/etc

    ports: # Exposes the port 24224 on both TCP and UDP protocol for log aggregation

      - "24224:24224"

      - "24224:24224/udp"

  kibana:

    image: kibana:8.12.0

    ports: # Runs kibana service on default port 5601

      - 5601:5601

    environment:

      - ELASTICSEARCH_URL=http://localhost:9200

      - ELASTICSEARCH_PASSWORD=hUEEiktfqz80TGhJi_Dl

      - ELASTICSEARCH_USERNAME=kibana_user

volumes:

  my-db:

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
  
      
